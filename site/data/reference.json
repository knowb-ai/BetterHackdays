    },
    {
      "id": "underminer",
      "title": "Underminer",
      "tags": [
        "Narrative Reconstruction",
        "Source Traceability",
        "Context Tracing"
      ],
      "summary": "Extract semantic understanding from paywalled reporting and reconstruct the story from alternate sources plus LLM context-tracing experiments.",
      "kind": "Website RFP"
    },
    {
      "id": "x-poser",
      "title": "X-Poser",
      "tags": [
        "Claim Checking",
        "Evidence Retrieval",
        "Smoke Test"
      ],
      "summary": "Submit an X link, run claim checks, and generate a report that marks the post as true, uncertain, or fabricated, with export-ready output for sharing on X.",
      "kind": "Website RFP"
    },
    {
      "id": "precongnition",
      "title": "Precongnition",
      "tags": [
        "Conference Discovery",
        "Session Continuity",
        "Learning Graph"
      ],
      "summary": "Detect missing or mismatched conference talks, tutorials, or demos, then crawl for alternate watch links and nearest neighboring sessions.",
      "kind": "Website RFP"
    },
    {
      "id": "marksweep",
      "title": "MarkSweep",
      "tags": [
        "Inbox Triage",
        "Browser Extension",
        "User Rules"
      ],
      "summary": "A browser extension granted control over your active tab that walks every unread message in your open inbox, checks each against relevance rules you control, marks non-matches as read in bulk, and flags matches to stay pinned at the top.",
      "kind": "Website RFP"
    },
    {
      "id": "subtracktor",
      "title": "Subtracktor",
      "tags": [
        "Subscription Escape",
        "Inbox Agents",
        "Financial Leakage"
      ],
      "summary": "Subtracktor is a browser extension that connects consent-fully to your email inbox once it detects an inbox open in the active tab. It scans only for account-creation and subscription-confirmation messages, then builds a per-account record of every subscription it finds.",
      "kind": "Website RFP"
    },
    {
      "id": "betterhackdays",
      "title": "BetterHackdays",
      "tags": [
        "Shared Hack Day",
        "Team Formation",
        "Project Continuity"
      ],
      "summary": "Help hack-day organizers move builders from event rules and tracks to a team, a focused idea, and a shared first-hour plan. BetterHackdays brings event context, opt-in participant profiles, matchmaking, and team workspaces into one live flow.",
      "kind": "Live project"
    },
    {
      "id": "betterlover",
      "title": "BetterLover",
      "tags": [
        "Care Planning",
        "Cycle-Aware Context",
        "Consent First"
      ],
      "summary": "Turn a person's chosen cycle, mood, energy, and care preferences into thoughtful, practical suggestions for a partner. The current prototype uses synthetic cycle data and produces a structured plan that can be reviewed before action.",
      "kind": "Live project"
    },
    {
      "id": "sepnu-pues",
      "title": "Sepnu Pues",
      "tags": [
        "Daily Follow-Through",
        "Opt-In Accountability",
        "User-Controlled Sharing"
      ],
      "summary": "Help people follow through on the tasks they set for themselves through a lightweight daily loop. The prototype pairs a task list with optional safe-cartoon generation, an accountability-email queue, and a prefilled social-post draft.",
      "kind": "Live project"
    }
  ],
